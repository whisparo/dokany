   (ضمان التقاط overrides الثيمات في أي مستوى DOM)
   ═══════════════════════════════════════════════════════════ */
@theme inline {
  --color-primary: var(--accent-primary);
  --color-primary-foreground: var(--primary-foreground);

  --color-background: var(--bg-base);
  --color-foreground: var(--text-primary);

  --color-secondary: var(--accent-secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-accent: var(--accent-tertiary);
  --color-accent-foreground: var(--accent-foreground);

  --color-muted: var(--bg-glass);
  --color-muted-foreground: var(--text-secondary);

  --color-border: var(--border-subtle);
  --color-ring: var(--accent-primary);
  --color-ring-offset: var(--bg-base);

  --color-success: var(--accent-success);
  --color-warning: var(--accent-warning);
  --color-danger: var(--accent-danger);

  /* Store-level aliases */
  --color-store-primary: var(--accent-primary);
  --color-store-secondary: var(--accent-secondary);
  --color-store-background: var(--bg-base);
  --color-store-text: var(--text-primary);

  --radius-store-card: var(--radius-lg);
  --radius-store-button: var(--radius-md);
  --radius-store-input: var(--radius-sm);
}

/* ═══════════════════════════════════════════════════════════
   3) THEME DEFINITIONS (Runtime Variables)
   ═══════════════════════════════════════════════════════════ */
:root {

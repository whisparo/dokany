  --border-glow: rgba(212, 175, 55, 0.4);
  --radius-lg: 20px;
}

/* ═══════════════════════════════════════════════════════════
   4) BASE STYLES
   ═══════════════════════════════════════════════════════════ */
@layer base {
  html, body {
    background-color: var(--bg-base);
    color: var(--text-primary);
    font-family: var(--font-arabic);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: clip; /* 2026: يقصّ دون كسر sticky ودون scroll container */
    -webkit-tap-highlight-color: transparent;
  }

  html[lang="en"] body {
    font-family: var(--font-sans);
  }

  /* عناوين متوازنة بدل السطر اليتيم */
  h1, h2, h3, h4, h5, h6 {
    text-wrap: balance;
  }

  /* ⚡ transitions للعناصر التفاعلية فقط — حماية الـ Main Thread */
  a, button, input, select, textarea, [role="button"] {
    transition-property: background-color, border-color, color, opacity;
    transition-duration: 0.2s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Scrollbar: قياسي + Webkit */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 10px; }

  /* Focus: outline أصلب من box-shadow (لا يُقصّ مع overflow) ويلف مع الـ radius */
  :focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Selection حيّ يتبع الثيم */
  ::selection {
    background-color: color-mix(in oklab, var(--accent-primary) 25%, transparent);
    color: inherit;
  }

  input, textarea, [contenteditable="true"] {
    caret-color: var(--accent-primary);
  }

  /* 🌿 حارس الحركة: احترام تفضيل المستخدم أولاً */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}

/* ═══════════════════════════════════════════════════════════
   5) UTILITIES (@utility — تعمل مع md: / rtl: / dark: ...)
   ═══════════════════════════════════════════════════════════ */
@utility glass {
  background-color: var(--bg-glass);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-subtle);
}

@utility glass-elevated {
  background-color: var(--bg-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-strong);
}

@utility glass-hover {
  transition: background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
              border-color 0.3s, box-shadow 0.3s, translate 0.3s;
  &:hover {
    background-color: var(--bg-glass-hover);
    border-color: var(--border-glow);
    box-shadow: var(--glow-primary);
    translate: 0 -2px;
  }
}

@utility mesh-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(40px);
  animation: var(--animate-mesh-float);
  pointer-events: none;
  will-change: transform;
}

@utility shimmer-text {
  background: var(--pearl-shimmer);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: var(--animate-shimmer);
}

@utility stat-number {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ═══════════════════════════════════════════════════════════
   6) NATIVE 2026 MOTION — دخول/خروج بالـ CSS الخالص
   (اترك العنصر mounted وبدّل data-state — وداعاً لـ JS hacks)
   ═══════════════════════════════════════════════════════════ */
@layer components {
  /* Drawer (مثالي لـ CartDrawer — متوافق مع نمط data-state في vaul) */
  [data-drawer] {
    --slide-from: 100%;
    translate: var(--slide-from) 0;
    transition: translate 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                display 0.45s allow-discrete;
  }
  [dir="rtl"] [data-drawer] { --slide-from: -100%; } /* انعكاس تلقائي RTL */
  [data-drawer][data-state="closed"] { display: none; }
  [data-drawer][data-state="open"] { translate: 0 0; }
  @starting-style {
    [data-drawer][data-state="open"] { translate: var(--slide-from) 0; }
  }

  /* Dialog / Sheet (مثالي لـ CartSheet و Modals) */
  [data-dialog] {
    opacity: 0;
    scale: 0.96;
    transition: opacity 0.25s ease, scale 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                display 0.25s allow-discrete;
  }
  [data-dialog][data-state="closed"] { display: none; }
  [data-dialog][data-state="open"] { opacity: 1; scale: 1; }
  @starting-style {
    [data-dialog][data-state="open"] { opacity: 0; scale: 0.96; }
  }
}

/* ═══════════════════════════════════════════════════════════
   7) KEYFRAMES (خارج @theme عمداً — تستخدمها @utility مخصصة)
   ═══════════════════════════════════════════════════════════ */
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes slide-up {
  from { opacity: 0; transform: translateY(15px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes scale-in {
  from { opacity: 0; transform: scale(0.96); }
  to   { opacity: 1; transform: scale(1); }
}

@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes mesh-float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33%      { transform: translate(20px, -20px) scale(1.05); }
  66%      { transform: translate(-15px, 15px) scale(0.98); }
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.5; }
  50%      { opacity: 1; }
}
</file>


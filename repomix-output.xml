}

/* ── Store Themes (تُركّب على غلاف المتجر) ── */
[data-store-theme="emerald"] {
  --accent-primary: #10b981;
  --accent-secondary: #059669;
  --primary-foreground: #04281c; /* كونتراست آمن على الزمردي */

  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.14);
  --border-glow: rgba(99, 102, 241, 0.45);

  --text-primary: #ffffff;
  --text-secondary: #f3f4f6;
  --text-tertiary: #a1a1aa;

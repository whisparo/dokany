    // ✅ الحوكمة والـ Soft Delete لاتساق النظام
    deletedAt: integer('deleted_at', { mode: 'timestamp' }),
    deletedBy: text('deleted_by'),

    // التواقيت الموحدة بنظام Unix Timestamp بالملي ثانية
    createdAt: integer('created_at', { mode: 'timestamp' })
      .notNull()

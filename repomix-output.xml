    description: 'Analytics and dashboard reporting queries',
  },

  // 🔓 8. الاستراتيجية الافتراضية
  default: {
    perIp: 60,
    perUser: 120,
    windowMs: 60000,
    description: 'Default rate limit for unspecified actions',

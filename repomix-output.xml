    title: text('title'),
    comment: text('comment').notNull(),


    pros: text('pros', { mode: 'json' }).$type<string[]>().notNull().default(sql`'[]'`),
    cons: text('cons', { mode: 'json' }).$type<string[]>().notNull().default(sql`'[]'`),

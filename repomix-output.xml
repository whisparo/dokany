import { z } from 'zod';








const MAX_CART_QUANTITY = 999;
const VARIANT_SKU_MAX = 255;




export const addToCartSchema = z.object({
  productId: z.string().uuid('معرف المنتج غير صالح'),
  storeId: z.string().uuid('معرف المتجر غير صالح'),

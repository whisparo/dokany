CREATE INDEX `stores_deleted_by_idx` ON `stores` (`deleted_by`);
CREATE INDEX `stores_slug_active_idx` ON `stores` (`slug`,`is_active`) WHERE "stores"."deleted_at" IS NULL;
CREATE INDEX `stores_geo_active_idx` ON `stores` (`country`,`city`,`is_active`) WHERE "stores"."is_active" = 1 AND "stores"."deleted_at" IS NULL;
CREATE INDEX `stores_featured_idx` ON `stores` (`is_featured`) WHERE "stores"."is_featured" = 1 AND "stores"."deleted_at" IS NULL;
CREATE INDEX `stores_deleted_idx` ON `stores` (`deleted_at`) WHERE "stores"."deleted_at" IS NULL;

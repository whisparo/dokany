      "checkConstraints": {
        "chk_item_status": {
          "name": "chk_item_status",
          "value": "\"order_items\".\"status\" IN ('pending', 'processing', 'shipped', 'delivered', 'cancelled', 'returned')"
        },
        "chk_fulfillment_status": {
          "name": "chk_fulfillment_status",
          "value": "\"order_items\".\"fulfillment_status\" IN ('unfulfilled', 'partial', 'fulfilled')"
        },
        "chk_return_status": {
          "name": "chk_return_status",
          "value": "\"order_items\".\"return_status\" IS NULL OR \"order_items\".\"return_status\" IN ('requested', 'approved', 'rejected', 'processed', 'refunded')"
        },
        "chk_qty_positive": {
          "name": "chk_qty_positive",
          "value": "\"order_items\".\"ordered_qty\" > 0"
        },
        "chk_cancelled_positive": {
          "name": "chk_cancelled_positive",
          "value": "\"order_items\".\"cancelled_qty\" >= 0"
        },
        "chk_shipped_positive": {
          "name": "chk_shipped_positive",
          "value": "\"order_items\".\"shipped_qty\" >= 0"
        },
        "chk_returned_positive": {
          "name": "chk_returned_positive",
          "value": "\"order_items\".\"returned_qty\" >= 0"
        },
        "chk_qty_integrity": {
          "name": "chk_qty_integrity",
          "value": "\"order_items\".\"cancelled_qty\" + \"order_items\".\"shipped_qty\" <= \"order_items\".\"ordered_qty\""
        },
        "chk_return_limit": {
          "name": "chk_return_limit",
          "value": "\"order_items\".\"returned_qty\" <= \"order_items\".\"shipped_qty\""
        },
        "chk_tax_rate_range": {
          "name": "chk_tax_rate_range",
          "value": "\"order_items\".\"tax_rate\" >= 0 AND \"order_items\".\"tax_rate\" <= 100"
        },
        "chk_commission_rate_range": {
          "name": "chk_commission_rate_range",
          "value": "\"order_items\".\"commission_rate\" >= 0 AND \"order_items\".\"commission_rate\" <= 100"
        },
        "chk_sku_not_empty": {
          "name": "chk_sku_not_empty",
          "value": "\"order_items\".\"product_sku\" != ''"
        },
        "chk_variant_sku_not_empty": {
          "name": "chk_variant_sku_not_empty",
          "value": "\"order_items\".\"variant_sku\" != ''"
        },
        "chk_product_name_not_empty": {
          "name": "chk_product_name_not_empty",
          "value": "\"order_items\".\"product_name\" != ''"
        }
      }

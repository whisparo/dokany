AFTER UPDATE ON stores
FOR EACH ROW
WHEN NEW.updated_at = OLD.updated_at OR NEW.updated_at IS NULL
BEGIN
  UPDATE stores SET updated_at = (unixepoch() * 1000) WHERE id = NEW.id;
END;


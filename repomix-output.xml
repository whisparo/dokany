interface FeaturedProductsProps {
  products: Product[];
  storeSlug: string;
  currency?: string;
  title?: string;
  description?: string;
  viewAllHref?: string;
}

export function FeaturedProducts({
  products,
  storeSlug,
  currency = 'EGP',
  title = 'منتجات مميرة',

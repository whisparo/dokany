      </div>
      {products.length > 0 && pagination && (
        <div className={theme.footer.container}>
          <Typography variant="caption" className={theme.footer.text}>
            عرض {products.length} من {pagination.total} منتج
          </Typography>
        </div>
      )}
    </section>
  );
}

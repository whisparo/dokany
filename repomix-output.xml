openapi: 3.0.0
info:
  title: Dokany API
  description: منصة دكاني - واجهات برمجة التطبيقات
  version: 1.1.0
  contact:
    name: Dokany Team
    url: https://dokany.com

servers:
  - url: https://api.dokany.com
    description: Production Server
  - url: http://localhost:3000
    description: Development Server

tags:
  - name: Auth
    description: المصادقة وإدارة الجلسات
  - name: User
    description: بيانات المستخدم والبروفايل
  - name: Store
    description: إدارة المتجر والإعدادات
  - name: Products
    description: المنتجات
  - name: Orders
    description: الطلبات والدفع
  - name: Categories
    description: التصنيفات
  - name: Cart
    description: سلة التسوق
  - name: Coupons
    description: الكوبونات
  - name: Haggle
    description: المساومة الذكية
  - name: Shipping
    description: الشحن والتوصيل
  - name: Media
    description: رفع وإدارة الميديا
  - name: Payments
    description: المدفوعات والمعاملات
  - name: Notifications
    description: الإشعارات والويب هوك
  - name: Health
    description: فحص صحة الخدمة

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
    storeIdHeader:
      type: apiKey
      in: header
      name: x-store-id

  schemas:
    ErrorResponse:
      type: object
      properties:
        success:
          type: boolean
          example: false
        code:
          type: string
          example: "VALIDATION_ERROR"
        message:
          type: string
          example: "بيانات غير صالحة"

    Store:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        slug:
          type: string
        shopName:
          type: string
        description:
          type: string
        logo:
          type: string
        coverImage:
          type: string
        phone:
          type: string
        email:
          type: string
        country:
          type: string
        currency:
          type: string
        settings:
          type: object
        theme:
          type: object
        isActive:
          type: boolean
        createdAt:
          type: string
          format: date-time

    StoreSettings:
      type: object
      properties:
        allowGuestCheckout:
          type: boolean
        enableReviews:
          type: boolean
        autoApproveOrders:
          type: boolean
        inventoryThreshold:
          type: integer
        socialLinks:
          type: object
          properties:
            facebook:
              type: string
            instagram:
              type: string
            twitter:
              type: string
            tiktok:
              type: string

    User:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        email:
          type: string
        phoneNumber:
          type: string
        image:
          type: string
        role:
          type: string
        merchantId:
          type: string
        createdAt:
          type: string
          format: date-time

    Address:
      type: object
      properties:
        id:
          type: string
        recipientName:
          type: string
        recipientPhone:
          type: string
        country:
          type: string
        city:
          type: string
        street:
          type: string
        building:
          type: string
        floor:
          type: string
        apartment:
          type: string
        isDefault:
          type: boolean

    Product:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        slug:
          type: string
        price:
          type: integer
        stock:
          type: integer
        isPublished:
          type: boolean
        createdAt:
          type: string
          format: date-time

    Order:
      type: object
      properties:
        id:
          type: string
        orderNumber:
          type: string
        status:
          type: string
          enum: [pending, confirmed, processing, shipped, delivered, cancelled]
        total:
          type: integer
        createdAt:
          type: string
          format: date-time

    Category:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        slug:
          type: string
        description:
          type: string
        image:
          type: string
        parentId:
          type: string
        isActive:
          type: boolean
        order:
          type: integer

    CartItem:
      type: object
      properties:
        productId:
          type: string
        variantSku:
          type: string
        quantity:
          type: integer

    CouponValidationRequest:
      type: object
      properties:
        storeId:
          type: string
        code:
          type: string
        cartTotalAmount:
          type: string
        customerId:
          type: string
        categoryId:
          type: string
        productId:
          type: string

    HaggleSession:
      type: object
      properties:
        id:
          type: string
        sessionCode:
          type: string
        status:
          type: string
          enum: [active, counter_offered, accepted, rejected, expired, cancelled]
        currentOffer:
          type: string

    MediaSignature:
      type: object
      properties:
        signature:
          type: string
        timestamp:
          type: integer
        cloudName:
          type: string
        apiKey:
          type: string
        publicId:
          type: string
        folder:
          type: string

    ShippingRate:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        description:
          type: string
        price:
          type: integer
        estimatedDays:
          type: integer

    PaymentRequest:
      type: object
      properties:
        orderId:
          type: string
        amount:
          type: integer
        currency:
          type: string
        method:
          type: string
        provider:
          type: string


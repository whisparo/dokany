      "checkConstraints": {
        "chk_direction": {
          "name": "chk_direction",
          "value": "\"telegram_messages\".\"direction\" IN ('incoming', 'outgoing')"
        },
        "chk_message_type": {
          "name": "chk_message_type",
          "value": "\"telegram_messages\".\"message_type\" IN ('text', 'photo', 'sticker', 'contact', 'callback_query', 'command', 'video', 'document', 'audio', 'voice', 'location', 'other')"
        },
        "chk_message_status": {
          "name": "chk_message_status",
          "value": "\"telegram_messages\".\"status\" IN ('pending', 'sent', 'delivered', 'read', 'failed', 'cancelled')"
        },
        "chk_language": {
          "name": "chk_language",
          "value": "\"telegram_messages\".\"language\" IN ('ar', 'en', 'fr', 'es')"
        },
        "chk_message_ownership": {
          "name": "chk_message_ownership",
          "value": "NOT (\"telegram_messages\".\"store_id\" IS NULL AND \"telegram_messages\".\"customer_id\" IS NOT NULL)"
        },
        "chk_telegram_message_id_positive": {
          "name": "chk_telegram_message_id_positive",
          "value": "\"telegram_messages\".\"telegram_message_id\" IS NULL OR \"telegram_messages\".\"telegram_message_id\" > 0"
        },
        "chk_reply_to_message_id_positive": {
          "name": "chk_reply_to_message_id_positive",
          "value": "\"telegram_messages\".\"reply_to_message_id\" IS NULL OR \"telegram_messages\".\"reply_to_message_id\" > 0"
        },
        "chk_update_id_positive": {
          "name": "chk_update_id_positive",
          "value": "\"telegram_messages\".\"update_id\" IS NULL OR \"telegram_messages\".\"update_id\" > 0"
        },
        "chk_command_format": {
          "name": "chk_command_format",
          "value": "\"telegram_messages\".\"command\" IS NULL OR (\"telegram_messages\".\"command\" GLOB '/*' AND length(\"telegram_messages\".\"command\") <= 50)"
        },
        "chk_content_length": {
          "name": "chk_content_length",
          "value": "\"telegram_messages\".\"content\" IS NULL OR length(\"telegram_messages\".\"content\") <= 4096"
        },
        "chk_caption_length": {
          "name": "chk_caption_length",
          "value": "\"telegram_messages\".\"caption\" IS NULL OR length(\"telegram_messages\".\"caption\") <= 1024"
        },
        "chk_attachments_limit": {
          "name": "chk_attachments_limit",
          "value": "json_array_length(\"telegram_messages\".\"attachments\") <= 10"
        },
        "chk_buttons_limit": {
          "name": "chk_buttons_limit",
          "value": "json_array_length(\"telegram_messages\".\"buttons\") <= 20"
        },
        "chk_entities_limit": {
          "name": "chk_entities_limit",
          "value": "json_array_length(\"telegram_messages\".\"entities\") <= 100"
        },
        "chk_retry_count_non_negative": {
          "name": "chk_retry_count_non_negative",
          "value": "\"telegram_messages\".\"retry_count\" >= 0"
        },
        "chk_spam_score_range": {
          "name": "chk_spam_score_range",
          "value": "\"telegram_messages\".\"spam_score\" BETWEEN 0 AND 100"
        },
        "chk_sent_consistency": {
          "name": "chk_sent_consistency",
          "value": "\"telegram_messages\".\"sent_at\" IS NULL OR \"telegram_messages\".\"status\" NOT IN ('pending')"
        },
        "chk_delivered_consistency": {
          "name": "chk_delivered_consistency",
          "value": "\"telegram_messages\".\"delivered_at\" IS NULL OR \"telegram_messages\".\"status\" IN ('delivered', 'read')"
        },
        "chk_read_consistency": {
          "name": "chk_read_consistency",
          "value": "\"telegram_messages\".\"read_at\" IS NULL OR \"telegram_messages\".\"status\" = 'read'"
        },
        "chk_failure_consistency": {
          "name": "chk_failure_consistency",
          "value": "(\"telegram_messages\".\"status\" != 'failed' AND \"telegram_messages\".\"failure_reason\" IS NULL) OR (\"telegram_messages\".\"status\" = 'failed' AND \"telegram_messages\".\"failure_reason\" IS NOT NULL)"
        },
        "chk_metadata_valid": {
          "name": "chk_metadata_valid",
          "value": "\"telegram_messages\".\"metadata\" IS NULL OR (json_valid(\"telegram_messages\".\"metadata\") = 1 AND json_type(\"telegram_messages\".\"metadata\") = 'object')"
        }
      }

  --secondary-foreground: #ffffff;
  --accent-foreground: #ffffff;
  /* 2026: السماح بانتقال height إلى auto */
  interpolate-size: allow-keywords;
}

[data-theme="dark"] {
  color-scheme: dark;

  --bg-base: #000000;
  --bg-elevated: rgba(10, 10, 12, 0.75);
  --bg-glass: rgba(12, 12, 16, 0.45);

CREATE UNIQUE INDEX `stores_telegram_chat_unique` ON `stores` (`telegram_chat_id`) WHERE "stores"."telegram_chat_id" IS NOT NULL AND "stores"."deleted_at" IS NULL;
CREATE UNIQUE INDEX `stores_telegram_username_unique` ON `stores` (`telegram_username`) WHERE "stores"."telegram_username" IS NOT NULL AND "stores"."deleted_at" IS NULL;

      "uniqueConstraints": {},
      "checkConstraints": {
        "chk_order_status": {
          "name": "chk_order_status",
          "value": "\"orders\".\"status\" IN ('pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled')"
        },
        "chk_payment_status": {
          "name": "chk_payment_status",
          "value": "\"orders\".\"payment_status\" IN ('pending', 'paid', 'failed', 'refunded', 'under_review')"
        },
        "chk_payment_method": {
          "name": "chk_payment_method",
          "value": "\"orders\".\"payment_method\" IS NULL OR \"orders\".\"payment_method\" IN ('cod', 'credit_card', 'wallet', 'bank_transfer', 'installments')"
        },
        "chk_shipping_method": {
          "name": "chk_shipping_method",
          "value": "\"orders\".\"shipping_method\" IN ('standard', 'express', 'same-day', 'pickup')"
        },
        "chk_order_currency": {
          "name": "chk_order_currency",
          "value": "\"orders\".\"currency\" GLOB '[A-Z][A-Z][A-Z]'"
        },
        "chk_total_non_negative": {
          "name": "chk_total_non_negative",
          "value": "CAST(\"orders\".\"total\" AS REAL) >= 0.0"
        },
        "chk_subtotal_non_negative": {
          "name": "chk_subtotal_non_negative",
          "value": "CAST(\"orders\".\"subtotal\" AS REAL) >= 0.0"
        },
        "chk_shipping_non_negative": {
          "name": "chk_shipping_non_negative",
          "value": "CAST(\"orders\".\"shipping_cost\" AS REAL) >= 0.0"
        },
        "chk_tax_non_negative": {
          "name": "chk_tax_non_negative",
          "value": "CAST(\"orders\".\"tax_amount\" AS REAL) >= 0.0"
        },
        "chk_discount_non_negative": {
          "name": "chk_discount_non_negative",
          "value": "CAST(\"orders\".\"discount\" AS REAL) >= 0.0"
        },
        "chk_haggle_discount_non_negative": {
          "name": "chk_haggle_discount_non_negative",
          "value": "CAST(\"orders\".\"haggle_discount\" AS REAL) >= 0.0"
        },
        "chk_order_total_calculation": {
          "name": "chk_order_total_calculation",
          "value": "\n      CAST(\"orders\".\"total\" AS REAL) = (\n        CAST(\"orders\".\"subtotal\" AS REAL) + \n        CAST(\"orders\".\"shipping_cost\" AS REAL) + \n        CAST(\"orders\".\"tax_amount\" AS REAL) - \n        CAST(\"orders\".\"discount\" AS REAL)\n      )\n    "
        },
        "chk_recipient_phone": {
          "name": "chk_recipient_phone",
          "value": "json_extract(\"orders\".\"shipping_address\", '$.recipientPhone') IS NOT NULL AND json_extract(\"orders\".\"shipping_address\", '$.recipientPhone') != ''"
        },
        "chk_recipient_name": {
          "name": "chk_recipient_name",
          "value": "json_extract(\"orders\".\"shipping_address\", '$.recipientName') IS NOT NULL AND json_extract(\"orders\".\"shipping_address\", '$.recipientName') != ''"
        },
        "chk_country": {
          "name": "chk_country",
          "value": "json_extract(\"orders\".\"shipping_address\", '$.country') IS NOT NULL AND json_extract(\"orders\".\"shipping_address\", '$.country') != ''"
        },
        "chk_payment_method_required": {
          "name": "chk_payment_method_required",
          "value": "(\"orders\".\"payment_method\" IS NOT NULL) OR (\"orders\".\"payment_status\" = 'pending')"
        },
        "chk_payment_review": {
          "name": "chk_payment_review",
          "value": "NOT (\"orders\".\"status\" IN ('processing', 'shipped', 'delivered') AND \"orders\".\"payment_status\" = 'under_review')"
        },
        "chk_discount_legit": {
          "name": "chk_discount_legit",
          "value": "CAST(\"orders\".\"discount\" AS REAL) <= CAST(\"orders\".\"subtotal\" AS REAL)"
        },
        "chk_haggle_legit": {
          "name": "chk_haggle_legit",
          "value": "(\"orders\".\"haggle_session_id\" IS NULL) OR (CAST(\"orders\".\"haggle_discount\" AS REAL) <= COALESCE(CAST(\"orders\".\"original_total\" AS REAL), 0.0))"
        },
        "chk_no_delete_shipped": {
          "name": "chk_no_delete_shipped",
          "value": "(\"orders\".\"deleted_at\" IS NULL) OR (\"orders\".\"status\" NOT IN ('shipped', 'delivered'))"
        },
        "chk_coupon_consistency": {
          "name": "chk_coupon_consistency",
          "value": "(\"orders\".\"coupon_id\" IS NULL) OR (\"orders\".\"coupon_code\" IS NOT NULL)"
        },
        "chk_confirmed_after_created": {
          "name": "chk_confirmed_after_created",
          "value": "(\"orders\".\"confirmed_at\" IS NULL OR \"orders\".\"confirmed_at\" >= \"orders\".\"created_at\")"
        },
        "chk_shipped_after_confirmed": {
          "name": "chk_shipped_after_confirmed",
          "value": "(\"orders\".\"shipped_at\" IS NULL OR (\"orders\".\"confirmed_at\" IS NOT NULL AND \"orders\".\"shipped_at\" >= \"orders\".\"confirmed_at\"))"
        },
        "chk_delivered_after_shipped": {
          "name": "chk_delivered_after_shipped",
          "value": "(\"orders\".\"delivered_at\" IS NULL OR (\"orders\".\"shipped_at\" IS NOT NULL AND \"orders\".\"delivered_at\" >= \"orders\".\"shipped_at\"))"
        },
        "chk_cancelled_after_created": {
          "name": "chk_cancelled_after_created",
          "value": "(\"orders\".\"cancelled_at\" IS NULL OR \"orders\".\"cancelled_at\" >= \"orders\".\"created_at\")"
        },
        "chk_status_confirmed": {
          "name": "chk_status_confirmed",
          "value": "(\"orders\".\"status\" != 'confirmed' OR \"orders\".\"confirmed_at\" IS NOT NULL)"
        },
        "chk_status_shipped": {
          "name": "chk_status_shipped",
          "value": "(\"orders\".\"status\" != 'shipped' OR \"orders\".\"shipped_at\" IS NOT NULL)"
        },
        "chk_status_delivered": {
          "name": "chk_status_delivered",
          "value": "(\"orders\".\"status\" != 'delivered' OR \"orders\".\"delivered_at\" IS NOT NULL)"
        },
        "chk_status_cancelled": {
          "name": "chk_status_cancelled",
          "value": "(\"orders\".\"status\" != 'cancelled' OR \"orders\".\"cancelled_at\" IS NOT NULL)"
        },
        "chk_refund_amount_positive": {
          "name": "chk_refund_amount_positive",
          "value": "(\"orders\".\"refund_amount\" IS NULL OR CAST(\"orders\".\"refund_amount\" AS REAL) > 0.0)"
        },
        "chk_refund_amount_max": {
          "name": "chk_refund_amount_max",
          "value": "(\"orders\".\"refund_amount\" IS NULL OR CAST(\"orders\".\"refund_amount\" AS REAL) <= CAST(\"orders\".\"total\" AS REAL))"
        },
        "chk_refund_consistency": {
          "name": "chk_refund_consistency",
          "value": "(\"orders\".\"refunded_at\" IS NULL OR \"orders\".\"refund_amount\" IS NOT NULL)"
        },
        "chk_original_total_exists": {
          "name": "chk_original_total_exists",
          "value": "(\"orders\".\"haggle_session_id\" IS NULL) OR (\"orders\".\"original_total\" IS NOT NULL)"
        },
        "chk_deleted_by_consistency": {
          "name": "chk_deleted_by_consistency",
          "value": "(\"orders\".\"deleted_at\" IS NULL OR \"orders\".\"deleted_by\" IS NOT NULL)"
        }
      }

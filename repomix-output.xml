    index('media_product_idx')
      .on(table.productId)
      .where(sql`${table.productId} IS NOT NULL`),
    index('media_category_idx')
      .on(table.categoryId)
      .where(sql`${table.categoryId} IS NOT NULL`),

    index('media_product_order_idx')
      .on(table.productId, table.order)

export type HaggleStatus =
  | 'active'
  | 'counter_offered'
  | 'accepted'
  | 'rejected'
  | 'expired'
  | 'cancelled';

export type HaggleStrategy =
  | 'aggressive'
  | 'friendly'
  | 'middle_ground';




export type CounterOffer = {
  from: 'customer' | 'bot';
  price: string;
  message?: string;
  timestamp: string;
  accepted?: boolean;
};





export const haggleSessions = sqliteTable(
  'haggle_sessions',

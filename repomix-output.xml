    // تأمين قيود الـ CAST والعمليات الحسابية للمبالغ المخزنة كنصوص
    check('chk_value_positive', sql`CAST(${table.value} AS REAL) > 0.0`),
    check('chk_min_order_positive', sql`CAST(${table.minOrderAmount} AS REAL) >= 0.0`),
